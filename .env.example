# ================================================================
# 操作手册智能体 Agent 2.0 - 环境变量配置
# 复制本文件为 .env 并填入对应值
# ================================================================

# ── 核心三件套 ──────────────────────────────────────────────────

# API Key（中转站给你的 Key）
API_KEY=sk-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# 接口地址（中转站的 base_url，必须以 /v1 结尾）
# OpenAI 官方：https://api.openai.com/v1
# 常见中转格式：https://your-proxy.com/v1
BASE_URL=https://api.openai.com/v1

# 模型名称（填中转站支持的模型名）
# 示例：gpt-5.4 / gpt-4o / claude-3-5-sonnet-20241022 / deepseek-chat
MODEL_NAME=gpt-4o

# 接口调用模式：
# - auto:             先走 chat.completions，失败后自动回退 responses（推荐）
# - chat_completions: 仅走 chat.completions
# - responses:        仅走 responses（如部分 codex/gpt-5 网关）
WIRE_API=auto

# 可选：兼容 Codex 配置中的 key 变量名
# 若同时配置 API_KEY 与 CRS_OAI_KEY，优先使用 API_KEY
CRS_OAI_KEY=

# ── 本地运行数据目录 ──────────────────────────────────────────
# 所有上传材料、生成结果、memory 都默认放在这里
# 默认值为仓库内的 workspace/，不写回代码主体
# 例如：
# MANUAL_AGENT_HOME=/Users/you/path/to/manual-agent/workspace
MANUAL_AGENT_HOME=

# 可选：格式规范文件路径，默认使用仓库内的 格式.md
MANUAL_AGENT_FORMAT_PATH=

# ── 输出手册文件仓库 ──────────────────────────────────────────
# 默认使用 Git 文件仓库管理输出手册。
# 未配置 FILE_REPO_DIR 时，会在代码仓库旁边创建兄弟目录 manual-agent-files/。
# FILE_REPO_URL 可为空：为空时初始化独立本地 Git 仓库；不为空时 clone 远端仓库。
# 如需临时回退旧的本地 workspace/outputs 输出方式，设置 FILE_STORE_BACKEND=local。
FILE_STORE_BACKEND=git
FILE_REPO_URL=
FILE_REPO_BRANCH=main
FILE_REPO_DIR=
FILE_REPO_AUTO_PUSH=false

# ── 阶段2问答策略（动态题量 + 并行）────────────────────────────
# 动态问题数量范围（质量优先，建议保持 5~10）
QUESTION_MIN=5
QUESTION_MAX=10

# 阶段2专家问答并发数（1=串行，建议 2~4）
PHASE2_PARALLEL_WORKERS=3

# ── 最大输出 Token ───────────────────────────────────────────────
# 留空 = 不传该参数，由中转站/模型决定最大输出（推荐）
# 手动指定示例：MAX_TOKENS=16384
MAX_TOKENS=
